# OS junk
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo

# Editor/IDE
.vscode/
.idea/
*.swp

# Large regeneratable raw sweep output
# (these come straight from the corpus scan and can be reproduced
#  by re-running scripts/ against the corpus at any time)
**/raw/*.gz

# Session-local scratch paths referenced in README (never actually in the zip,
# but ignore just in case a future run drops them here)
scratchpad/
tmp/
/tmp/

# Local corpus path if anyone ever runs scripts/ inside this repo by mistake
E3_Engine/
